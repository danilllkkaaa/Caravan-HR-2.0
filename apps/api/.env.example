# Application
APP_ENV=development
APP_DEBUG=false
APP_SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
APP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database
DATABASE_URL=postgresql+asyncpg://portal:portal@localhost:5432/portal
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=60

# JWT
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_SICK_LEAVE=sick-leave-documents
MINIO_SECURE=false

# Sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=development

# 1C Integration
OC_BASE_URL=http://1c-server/hr/hs/
OC_USERNAME=service_user
OC_PASSWORD=service_password
OC_TIMEOUT=30

# Hikvision Webhook
HIKVISION_HMAC_SECRET=change-me-hikvision-hmac-secret
HIKVISION_ATTENDANCE_STREAM=attendance:raw

# Account Locking
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# Push Notifications (Firebase)
FIREBASE_CREDENTIALS_PATH=
