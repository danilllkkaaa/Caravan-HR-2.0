# Copy to .env on the deployment host and replace every placeholder.

DOMAIN=portal.example.com
REGISTRY=ghcr.io/company
API_IMAGE_TAG=latest

POSTGRES_USER=portal
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=portal

REDIS_PASSWORD=change-me-redis

MINIO_ACCESS_KEY=portal-minio
MINIO_SECRET_KEY=change-me-minio
MINIO_REGION=us-east-1

APP_ENV=production
APP_SECRET_KEY=change-me-app-secret-32-plus-chars
APP_ALLOWED_ORIGINS=https://portal.example.com

JWT_SECRET_KEY=change-me-jwt-secret-32-plus-chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-fernet-key

SENTRY_DSN=
SENTRY_ENVIRONMENT=production

OC_BASE_URL=https://onec.example.com
OC_USERNAME=portal
OC_PASSWORD=change-me-1c

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=portal@example.com
SMTP_PASSWORD=change-me-smtp
SMTP_FROM_EMAIL=portal@example.com

MINIO_BUCKET_SICK_LEAVE=sick-leave-documents
MINIO_BUCKET_PERSONAL_DATA=personal-data-documents
MINIO_PUBLIC_ENDPOINT=portal.example.com
MINIO_PUBLIC_SECURE=true

GRAFANA_ADMIN_PASSWORD=change-me-grafana
